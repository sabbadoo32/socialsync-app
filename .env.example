# --- Database (Supabase Postgres) ---
# Pooled connection (used by the app at runtime). From Supabase: Settings > Database > Connection string > "Transaction" pooler.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (used by Prisma migrations). "Session" pooler / direct, port 5432.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase (Storage + client) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Cron security ---
# A random string. Vercel Cron sends this as the Authorization bearer; the /api/cron route rejects anything else.
CRON_SECRET="generate-a-long-random-string"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Bluesky (per-user creds are stored in DB; these are only for a quick local test) ---
BLUESKY_TEST_IDENTIFIER="you.bsky.social"
BLUESKY_TEST_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
